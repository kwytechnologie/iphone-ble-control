<Page x:Class="BleHid.App.Views.CapturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:BleHid.App.Converters"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="Controle">

  <Page.Resources>
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseVisibility" Invert="True" />
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24,0,24,24">

      <ui:TextBlock Text="Controle" FontTypography="TitleLarge" Margin="0,0,0,4" />
      <ui:TextBlock Text="Use o teclado e mouse entre o PC e o iPhone. Escolha a posição do telefone para entrar pela borda da tela."
                    FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" Margin="0,0,0,20" />

      <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,16"
                  Title="Controle ativado"
                  Message="{Binding CaptureHelp}"
                  IsOpen="{Binding IsCapturing}" />

      <ui:InfoBar Severity="Error" IsClosable="False" Margin="0,0,0,16"
                  Title="Não foi possível manter o controle" Message="{Binding CaptureError}"
                  IsOpen="{Binding HasCaptureError}" />

      <ui:CardControl Margin="0,0,0,16"
                      Visibility="{Binding Settings.EdgeSwitchEnabled, Converter={StaticResource BoolToVisibility}}">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Estado do modo telas" FontTypography="BodyStrong" />
            <ui:TextBlock Text="{Binding ScreenModeStatus}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button Content="{Binding ScreenModeButtonText}" Click="OnToggleScreenMode"
                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </ui:CardControl>

      <StackPanel IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBool}}">
        <ui:CardControl Margin="0,0,0,12">
          <ui:CardControl.Header>
            <StackPanel>
              <ui:TextBlock Text="Passar para o iPhone pela borda" FontTypography="BodyStrong" />
              <ui:TextBlock Text="Um destino por vez, como usar dois monitores." TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </ui:CardControl.Header>
          <ui:ToggleSwitch IsChecked="{Binding Settings.EdgeSwitchEnabled, Mode=TwoWay}"
                           AutomationProperties.Name="Passar para o iPhone pela borda" />
        </ui:CardControl>

        <Border x:Name="LayoutPanel" Padding="16" Margin="0,0,0,16" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Visibility="{Binding Settings.EdgeSwitchEnabled, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <ui:TextBlock Text="Posição das telas" FontTypography="Subtitle" />
            <ui:TextBlock Text="Escolha o lado em que você colocou o iPhone. A posição é salva neste PC."
                          TextWrapping="Wrap" Margin="0,4,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid Height="210" MaxWidth="440" HorizontalAlignment="Stretch">
              <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="90" /><RowDefinition /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="160" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <RadioButton Grid.Row="0" Grid.Column="1" Content="iPhone acima" GroupName="PhonePosition"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsPhoneTop, Mode=TwoWay}" />
              <RadioButton Grid.Row="1" Grid.Column="0" Content="À esquerda" GroupName="PhonePosition"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsPhoneLeft, Mode=TwoWay}" />
              <Border Grid.Row="1" Grid.Column="1" BorderThickness="2" CornerRadius="6" Margin="8,4"
                      BorderBrush="{DynamicResource TextFillColorSecondaryBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <ui:SymbolIcon Symbol="Desktop24" FontSize="24" HorizontalAlignment="Center" />
                  <ui:TextBlock Text="PC" FontTypography="BodyStrong" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
              <RadioButton Grid.Row="1" Grid.Column="2" Content="À direita" GroupName="PhonePosition"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsPhoneRight, Mode=TwoWay}" />
              <RadioButton Grid.Row="2" Grid.Column="1" Content="iPhone abaixo" GroupName="PhonePosition"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsPhoneBottom, Mode=TwoWay}" />
            </Grid>
            <ui:TextBlock Text="Monitor do PC" FontTypography="BodyStrong" Margin="0,8,0,4" />
            <DockPanel>
              <ui:Button DockPanel.Dock="Right" Content="Atualizar" Click="OnRefreshMonitors" Margin="8,0,0,0" />
              <ComboBox ItemsSource="{Binding Monitors}" DisplayMemberPath="Title" SelectedValuePath="Id"
                        SelectedValue="{Binding EdgeMonitorId, Mode=TwoWay}" AutomationProperties.Name="Monitor do PC" />
            </DockPanel>
            <ui:TextBlock Text="Destino da borda" FontTypography="BodyStrong" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Hosts}" DisplayMemberPath="Display" SelectedValuePath="DeviceId"
                      SelectedValue="{Binding EdgeHostId, Mode=TwoWay}" AutomationProperties.Name="iPhone de destino" />
            <ui:TextBlock Text="Escolha o iPhone conectado. Se houver apenas um dispositivo, ele será selecionado ao ativar."
                          FontTypography="Caption" TextWrapping="Wrap" Margin="0,4,0,12" />
            <ui:TextBlock Text="Para entrar: mova dentro da tela, encoste no meio da borda escolhida e aguarde 0,35 s, mesmo com o cursor parado. Não segure teclas ou botões. A passagem entre monitores do próprio PC fica livre."
                          TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:TextBlock Text="Para voltar, configure as opções abaixo. Ctrl+Alt+Q continua disponível como resgate. Não espelha a tela nem permite arrastar janelas ou arquivos."
                          TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBool}}" Margin="0,0,0,16">
        <ui:TextBlock Text="Voltar ao PC sem teclado" FontTypography="Subtitle" Margin="0,0,0,8" />
        <CheckBox Content="Clique da rodinha volta ao PC" IsChecked="{Binding Settings.MiddleClickReturn, Mode=TwoWay}" />
        <ui:TextBlock Text="Pressione a rodinha, sem girá-la. Só substitui o clique central enquanto controla o iPhone; rolagem e clique central no PC continuam normais."
                      TextWrapping="Wrap" Margin="0,4,0,12" FontTypography="Caption" />
        <CheckBox Content="Voltar pela borda estimada (experimental)" IsChecked="{Binding Settings.EstimatedEdgeReturn, Mode=TwoWay}"
                  IsEnabled="{Binding Settings.EdgeSwitchEnabled}" />
        <ui:TextBlock Text="Usa o lado oposto à posição escolhida do iPhone. Precisa do modo telas. É uma estimativa dos movimentos, não da posição real: pode voltar cedo ou tarde após toques ou aceleração do iPhone."
                      TextWrapping="Wrap" Margin="0,4,0,8" FontTypography="Caption" />
        <StackPanel IsEnabled="{Binding Settings.EstimatedEdgeReturn}">
          <ui:TextBlock Text="Distância virtual (não são pixels da tela do iPhone)" />
          <Slider Minimum="100" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True"
                  Value="{Binding Settings.EstimatedTravel, Mode=TwoWay}" AutomationProperties.Name="Distância de retorno estimado" />
          <ui:TextBlock Text="{Binding Settings.EstimatedTravel}" />
        </StackPanel>
        <ui:TextBlock Text="Cada entrada começa no centro virtual. Se voltar cedo demais, aumente a distância; se voltar tarde, diminua. Mova em direção ao PC até ultrapassar a borda estimada. Não retorna automaticamente durante arrastes ou teclas pressionadas."
                      TextWrapping="Wrap" Margin="0,4,0,8" FontTypography="Caption" />
        <ui:TextBlock Text="Touchpad: rolagem com dois dedos não é usada como atalho. Se o touchpad já tiver gesto de clique central, ele funciona; nenhum gesto do Windows será reconfigurado. Desative o controle antes de mudar estas opções."
                      TextWrapping="Wrap" FontTypography="Caption" />
      </StackPanel>

      <ui:InfoBar Severity="Informational" IsClosable="False" Margin="0,0,0,16"
                  Title="Aguardando conexão"
                  Visibility="{Binding Settings.EdgeSwitchEnabled, Converter={StaticResource InverseVisibility}}"
                  Message="Inicie o periférico na página Início e faça o pareamento pelo iPhone antes de ativar o controle."
                  IsOpen="{Binding CanCapture, Converter={StaticResource InverseBool}}" />

      <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}" Margin="0,0,0,8"
                      Visibility="{Binding Settings.EdgeSwitchEnabled, Converter={StaticResource InverseVisibility}}">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Ativar controle de teclado e mouse" FontTypography="BodyStrong" TextWrapping="Wrap" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Target, StringFormat='Destino: {0}'}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="CaptureToggle"
                         IsChecked="{Binding IsCapturing, Mode=OneWay}"
                         IsEnabled="{Binding CanToggleCapture}"
                         Click="OnToggleCapture" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Timer24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="Intervalo mínimo do ponteiro" FontTypography="BodyStrong" TextWrapping="Wrap" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="O Windows 11 usa o intervalo negociado com o dispositivo. Aumente o mínimo se o cursor acumular atraso; o movimento pode ficar menos fluido." />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Slider Width="160" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center"
                  Value="{Binding PointerIntervalMs, Mode=TwoWay}"
                  IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBool}}" />
          <ui:TextBlock Width="52" Margin="12,0,0,0" VerticalAlignment="Center"
                        Text="{Binding PointerIntervalMs, StringFormat='{}{0} ms'}" />
        </StackPanel>
      </ui:CardControl>

      <ui:TextBlock Text="Atalhos durante o controle" FontTypography="Subtitle" Margin="0,20,0,8" />

      <ui:CardControl Icon="{ui:SymbolIcon ArrowSwap24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <ui:TextBlock Text="Alternar entre os dispositivos e este PC" FontTypography="BodyStrong" TextWrapping="Wrap" />
        </ui:CardControl.Header>
        <ui:TextBlock Text="Ctrl + D + C" FontFamily="Cascadia Mono, Consolas" />
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Dismiss24}">
        <ui:CardControl.Header>
          <ui:TextBlock Text="Voltar ao PC (no modo telas, a borda continua ativa)" FontTypography="BodyStrong" TextWrapping="Wrap" />
        </ui:CardControl.Header>
        <ui:TextBlock Text="Ctrl + Alt + Q" FontFamily="Cascadia Mono, Consolas" />
      </ui:CardControl>

  </StackPanel>
  </ScrollViewer>
</Page>
