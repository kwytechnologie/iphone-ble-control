<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>BleHid.VirtualDisplayHost</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BleHid.VirtualDisplayHost.Tests" />
    <None Include="..\NativeCallbacks\artifacts\win-x64\BleHid.NativeCallbacks.dll"
          Link="BleHid.NativeCallbacks.dll" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="RequireNativeCallbackBridge" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\NativeCallbacks\artifacts\win-x64\BleHid.NativeCallbacks.dll')"
           Text="Compile tools/NativeCallbacks first; see tools/NativeCallbacks/README.md. The native callback DLL is required." />
  </Target>
</Project>
